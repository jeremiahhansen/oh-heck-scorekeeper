{
  "name": "oh-heck-scorekeeper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Offline-capable scorekeeper for the card game Oh Heck, with CSV export compatible with oh-heck-scoresheets",
  "scripts": {
    "predev": "node scripts/generate-icons.mjs",
    "dev": "vite",
    "predev:lan": "node scripts/generate-icons.mjs",
    "dev:lan": "vite --host",
    "prebuild": "node scripts/generate-icons.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
